#!/usr/bin/env bash
# tools/agent-run — prepare, or execute, one Linear issue as an autonomous agent task.
#
# The default is PREPARE, not execute. `prepare` does everything up to the point of running
# an agent and prints the exact command to run. Execution requires --execute, so a bare
# invocation can never start a model against your repository by accident.
#
# Usage:
#   tools/agent-run OG-55                  prepare: branch + prompt file + Linear update
#   tools/agent-run OG-55 --execute        actually run the agent in the sandbox
#   tools/agent-run --next                 next unstarted issue, prepare
#   tools/agent-run OG-55 --agent omp      choose the agent (default: codex)
#   tools/agent-run OG-55 --dry-run        print the plan, touch nothing
#   tools/agent-run OG-55 --keep           keep the container after the run (debugging)
#
# Prepare does:
#   1. resolve the issue (explicit key, or --next)
#   2. refuse to start unless the tree is clean and on main
#   3. create branch issue/og-nn-<slug>
#   4. write .agent-task/prompt.md   — the full task brief for the agent
#   5. write .agent-task/run.sh      — the exact sandbox command, self-contained
#   6. move the issue to In Progress and leave a start comment
#
# Execute (--execute) additionally:
#   7. runs run.sh in the sandbox
#   8. commits, pushes, opens a PR, links it on the issue
#
# It never merges. Human review is the gate (see AGENTS.md).
set -euo pipefail

REPO_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$REPO_ROOT"

AGENT="codex"
ISSUE=""
DRY_RUN=0
KEEP=0
EXECUTE=0
TIMEOUT="${DCOMPACT_AGENT_TIMEOUT:-3600}"
IMAGE="dcompact-sandbox:latest"
TASK_DIR=".agent-task"

while [[ $# -gt 0 ]]; do
  case "$1" in
    --agent)   AGENT="${2:?--agent needs a value}"; shift 2 ;;
    --next)    ISSUE="--next"; shift ;;
    --execute) EXECUTE=1; shift ;;
    --dry-run) DRY_RUN=1; shift ;;
    --keep)    KEEP=1; shift ;;
    --timeout) TIMEOUT="${2:?--timeout needs a value}"; shift 2 ;;
    -*)        echo "unknown flag: $1" >&2; exit 2 ;;
    *)         ISSUE="$1"; shift ;;
  esac
done

[[ -z "$ISSUE" ]] && {
  echo "usage: tools/agent-run OG-nn [--execute] [--agent codex|omp] [--dry-run] [--keep]" >&2
  exit 2
}

info() { printf '\033[36m%s\033[0m\n' "$*"; }
warn() { printf '\033[33m%s\033[0m\n' "$*"; }
die()  { printf '\033[31merror: %s\033[0m\n' "$*" >&2; exit 1; }

# ---------- 1. resolve the issue ----------
if [[ "$ISSUE" == "--next" ]]; then
  line="$(./tools/linear next)"
  [[ -z "$line" ]] && die "no unstarted issue found in the project"
  ISSUE="${line%%$'\t'*}"
  info "next issue: $line"
fi

[[ "$ISSUE" =~ ^OG-[0-9]+$ ]] || die "expected an issue key like OG-55, got '$ISSUE'"

ISSUE_TEXT="$(./tools/linear show "$ISSUE")"
ISSUE_URL="$(printf '%s\n' "$ISSUE_TEXT" | grep -m1 '^https://' || true)"
TITLE="$(printf '%s\n' "$ISSUE_TEXT" | head -1 | sed 's/^# [A-Z]*-[0-9]* [—-] //')"
SLUG="$(printf '%s' "$TITLE" \
  | tr '[:upper:]' '[:lower:]' \
  | sed 's/[^a-z0-9][^a-z0-9]*/-/g; s/^-//; s/-$//' \
  | cut -c1-40)"
BRANCH="issue/$(printf '%s' "$ISSUE" | tr '[:upper:]' '[:lower:]')-${SLUG}"

info "issue:  $ISSUE — $TITLE"
info "branch: $BRANCH"
info "agent:  $AGENT"
info "mode:   $( [[ $EXECUTE -eq 1 ]] && echo execute || echo prepare )"

if [[ $DRY_RUN -eq 1 ]]; then
  echo
  echo "--- plan (dry run, nothing executed) ---"
  echo "1. verify clean tree on main"
  echo "2. git switch -c $BRANCH"
  echo "3. write $TASK_DIR/prompt.md  (full task brief)"
  echo "4. write $TASK_DIR/run.sh     (exact sandbox command)"
  echo "5. ./tools/linear start $ISSUE  + start comment"
  if [[ $EXECUTE -eq 1 ]]; then
    echo "6. docker run → $AGENT executes the prompt inside the sandbox"
    echo "7. git commit, push -u origin $BRANCH, gh pr create"
    echo "8. ./tools/linear comment $ISSUE <pr-url>"
  else
    echo
    echo "(without --execute, the command stops after step 5 and prints the command for step 6)"
  fi
  exit 0
fi

# ---------- 2. clean-tree guard ----------
BRANCH_NOW="$(git rev-parse --abbrev-ref HEAD)"
[[ "$BRANCH_NOW" == "main" ]] || die "not on main (on '$BRANCH_NOW'); switch to main first"
[[ -z "$(git status --porcelain)" ]] || die "working tree is dirty; commit or stash first"
git fetch -q origin main 2>/dev/null && git merge -q --ff-only origin/main 2>/dev/null || true

# ---------- 3. branch ----------
git switch -q -c "$BRANCH"
info "created $BRANCH"

# ---------- 4. task brief ----------
mkdir -p "$TASK_DIR"
PROMPT_FILE="$TASK_DIR/prompt.md"

{
  echo "# Task — $ISSUE: $TITLE"
  echo
  echo "You are implementing one issue in the dcompact repository."
  echo
  echo "## Read first, in order"
  echo
  echo "1. \`AGENTS.md\` — non-negotiable invariants and working rules"
  echo "2. \`docs/CONCEPT.md\` — problem, architecture, integration matrix"
  echo "3. \`docs/SCHEMA.md\` — **normative**; if code disagrees with it, code is wrong"
  echo "4. \`docs/DEVELOPMENT_PLAN.md\` — phase detail, waves, exit criteria"
  echo
  echo "## The issue"
  echo
  printf '%s\n' "$ISSUE_TEXT"
  echo
  echo "## Rules"
  echo
  echo "- Implement **only** this issue. Do not start the next phase."
  echo "- Respect every invariant in AGENTS.md: no model in the extraction path, determinism"
  echo "  of the hashed payload, core purity, no network."
  echo "- Every failure path you introduce needs a test in this same change."
  echo "- Do not weaken, skip, or delete a test to get green."
  echo "- Do not touch anything outside /home/agent/work."
  echo "- Run the test suite before finishing. It must pass."
  echo "- Commit using the repository commit format (see AGENTS.md) and reference $ISSUE."
  echo "- Finish with a short summary: what changed, what you verified, what is uncertain."
  echo
  echo "## If you cannot finish"
  echo
  echo "If the issue is blocked (missing dependency, an unpassed wave gate, an ambiguous"
  echo "requirement), stop and state precisely what blocks it. Do not invent scope, and do"
  echo "not stub out the blocked part to make the suite pass."
} > "$PROMPT_FILE"
info "wrote $PROMPT_FILE"

# ---------- 5. exact run command ----------
RUN_FILE="$TASK_DIR/run.sh"
VMODE="--rm -i"
[[ $KEEP -eq 1 ]] && VMODE="--name dcompact-agent-run -i"

{
  echo "#!/usr/bin/env bash"
  echo "# Generated by tools/agent-run for $ISSUE. Runs the agent inside the sandbox."
  echo "# The container receives NO GitHub or Linear credential — the host does the"
  echo "# commit, push, PR and Linear updates. See tools/HOST-SETUP.md."
  echo "set -euo pipefail"
  echo "cd \"\$(dirname \"\$0\")/..\""
  echo
  echo "docker run $VMODE \\"
  echo "  --network bridge \\"
  echo "  -v \"\$PWD\":/home/agent/work \\"
  echo "  -w /home/agent/work \\"
  echo "  --memory 4g --cpus 4 \\"
  echo "  --user \"\$(id -u):\$(id -g)\" \\"
  case "$AGENT" in
    codex)
      echo "  -v \"\$HOME/.dcompact-agent/codex-home\":/home/agent/.codex \\"
      echo "  $IMAGE \\"
      echo "  bash -lc 'exec npx -y @openai/codex@latest exec --skip-git-repo-check \\"
      echo "            --dangerously-bypass-approvals-and-sandbox -' \\"
      echo "  < $PROMPT_FILE"
      ;;
    omp)
      echo "  --env-file \"\$HOME/.dcompact-agent/omp.env\" \\"
      echo "  $IMAGE \\"
      echo "  bash -lc 'exec /usr/local/bin/omp -p --auto-approve -' \\"
      echo "  < $PROMPT_FILE"
      ;;
    *)  die "unknown agent: $AGENT (expected codex or omp)" ;;
  esac
} > "$RUN_FILE"
chmod +x "$RUN_FILE"
info "wrote $RUN_FILE"

# ---------- 6. Linear: in progress ----------
./tools/linear start "$ISSUE" >/dev/null
./tools/linear comment "$ISSUE" "Task prepared: branch \`$BRANCH\`, agent \`$AGENT\`, sandboxed. Brief at \`.agent-task/prompt.md\`." >/dev/null || true
info "Linear: $ISSUE set to In Progress"

# ---------- prepare-only exit ----------
if [[ $EXECUTE -eq 0 ]]; then
  cat <<EOF

────────────────────────────────────────────────────────────
Task prepared. Nothing has been run.

  Brief:    $PROMPT_FILE
  Command:  $RUN_FILE

To run it yourself:      ./$RUN_FILE
To let this script run:  tools/agent-run $ISSUE --execute
To abandon:              git switch main && git branch -D $BRANCH
                         ./tools/linear status $ISSUE   # then reset to Backlog if needed
────────────────────────────────────────────────────────────
EOF
  exit 0
fi

# ---------- 7. execute ----------
BUILD_NEEDED=0
docker image inspect "$IMAGE" >/dev/null 2>&1 || BUILD_NEEDED=1
if [[ $BUILD_NEEDED -eq 1 ]]; then
  info "building sandbox image (first run only, a few minutes)…"
  docker build -t "$IMAGE" tools/sandbox
fi

info "starting agent (timeout ${TIMEOUT}s)…"
echo

set +e
timeout "$TIMEOUT" ./"$RUN_FILE"
RC=$?
set -e

echo
info "agent exited with status $RC"

# ---------- 8. commit, push, PR ----------
if [[ -z "$(git status --porcelain)" ]]; then
  warn "agent produced no changes"
  ./tools/linear comment "$ISSUE" "Agent run finished with no changes (exit $RC)." >/dev/null || true
  exit "$RC"
fi

echo
info "changed files:"
git status --short

git add -A
git -c user.name="dcompact agent" -c user.email="agent@dcompact.local" \
  commit -q -m "feat: $TITLE" \
            -m "Autonomous run on $ISSUE (agent: $AGENT, sandboxed)." \
            -m "Refs: $ISSUE"

git push -q -u origin "$BRANCH"

PR_BODY="$(mktemp)"
{
  echo "Linear: ${ISSUE_URL:-$ISSUE}"
  echo
  echo "Autonomous sandboxed run (\`$AGENT\`), exit status $RC."
  echo
  echo "**The agent does not merge.** Review the diff, then:"
  echo
  echo '```'
  echo "gh pr merge --squash --delete-branch"
  echo "./tools/linear done $ISSUE"
  echo '```'
  echo
  echo "Task brief: \`.agent-task/prompt.md\`"
  echo
  echo "Refs: $ISSUE"
} > "$PR_BODY"

PR_URL="$(gh pr create --title "$ISSUE — $TITLE" --body-file "$PR_BODY" \
  --base main --head "$BRANCH" 2>&1 | tail -1)"
rm -f "$PR_BODY"

info "PR: $PR_URL"
./tools/linear comment "$ISSUE" "Agent run complete → $PR_URL" >/dev/null || true

echo
info "review the PR, merge it, then: ./tools/linear done $ISSUE"
exit "$RC"
