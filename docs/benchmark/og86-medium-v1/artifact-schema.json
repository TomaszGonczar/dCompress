{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OG-86 sanitized arm result",
  "type": "object",
  "required": ["opaqueArm", "modelCounts", "checkpoints", "continuation", "invalidations"],
  "properties": {
    "opaqueArm": { "enum": ["X1", "X2", "X3"] },
    "modelCounts": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } },
    "checkpoints": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": ["ordinal", "manualCompaction", "sourceTranscriptBytes", "sourceTranscriptLines", "sourceTranscriptSha256", "treatmentBytes", "treatmentSha256", "score"],
        "properties": {
          "ordinal": { "type": "integer", "minimum": 1, "maximum": 4 },
          "manualCompaction": { "const": true },
          "sourceTranscriptBytes": { "type": "integer", "minimum": 1 },
          "sourceTranscriptLines": { "type": "integer", "minimum": 1 },
          "sourceTranscriptSha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
          "treatmentBytes": { "type": "integer", "minimum": 0, "maximum": 16384 },
          "treatmentSha256": { "type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$" },
          "score": { "type": "object" }
        },
        "additionalProperties": true
      }
    },
    "continuation": { "type": "object" },
    "invalidations": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": true
}
